# 이 파일을 .env로 복사한 뒤 값을 채운다. (.env는 커밋되지 않음)
# 저장소 안 .env 또는 상위 폴더의 .env 중 있는 것을 읽는다.

# Amazon Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# 국세청 사업자등록 상태조회 (data.go.kr, Decoding 키). LIVE 모드에서만 필요
DATA_GO_KR_API_KEY=

# FIXTURE(기본, 평가용) | LIVE(국세청 실시간 조회, 시연용)
API_MODE=FIXTURE

# 선택: 모델 변경
# LLM_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
# LLM_FALLBACK_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0
